#!/usr/bin/env python3
"""Change the account's default login shell; omit a shell to toggle Bash/Zsh."""
from pathlib import Path as _CliPath
import sys as _cli_sys
_cli_sys.path.insert(0, str(_CliPath(__file__).resolve().parents[1] / "scripts"))
from cli_support import prepare as _prepare_cli
_prepare_cli(_CliPath(__file__).name)
from pathlib import Path
import runpy
import sys

sys.argv.insert(1, '--default')
runpy.run_path(str(Path(__file__).resolve().parents[1] / 'scripts/shell_manager.py'), run_name='__main__')
