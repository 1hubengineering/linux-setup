#!/usr/bin/env python3
"""Create or enter a tmux workspace for a project directory."""
from pathlib import Path as _CliPath
import sys as _cli_sys
_cli_sys.path.insert(0, str(_CliPath(__file__).resolve().parents[1] / "scripts"))
from cli_support import prepare as _prepare_cli
_prepare_cli(_CliPath(__file__).name)
import hashlib
import os
from pathlib import Path
import re
import subprocess
import sys

from cli_support import ArgumentParser
parser = ArgumentParser(description=__doc__)
parser.add_argument('project_directory', nargs='?', default='.', help='Project folder (default: current directory)')
args = parser.parse_args()
project = Path(args.project_directory).expanduser().resolve()
if not project.is_dir():
    sys.exit(f"Not a directory: {project}")
name = re.sub(r"[^a-zA-Z0-9_-]", "-", project.name or "root")
name += "-" + hashlib.sha256(str(project).encode()).hexdigest()[:8]
if os.environ.get("TMUX"):
    existing = subprocess.run(["tmux", "has-session", "-t", "=" + name], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if existing.returncode:
        subprocess.run(["tmux", "new-session", "-d", "-s", name, "-c", str(project)], check=True)
    command = ["tmux", "switch-client", "-t", "=" + name]
else:
    command = ["tmux", "new-session", "-A", "-s", name, "-c", str(project)]
os.execvp(command[0], command)
