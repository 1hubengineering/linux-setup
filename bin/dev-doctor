#!/usr/bin/env python3
from pathlib import Path as _CliPath
import sys as _cli_sys
_cli_sys.path.insert(0, str(_CliPath(__file__).resolve().parents[1] / "scripts"))
from cli_support import prepare as _prepare_cli
_prepare_cli(_CliPath(__file__).name)
import os
from pathlib import Path
import runpy
import sys

from cli_support import ArgumentParser
parser = ArgumentParser(description="Check linux-setup's tools and shell integration.")
parser.add_argument('--check', action='store_true', help='Check installed tools (the default action)')
parser.parse_args()
root = Path(__file__).resolve().parents[1]
sys.argv = [str(root / "scripts/setup.py"), "--check"]
runpy.run_path(str(root / "scripts/setup.py"), run_name="__main__")
