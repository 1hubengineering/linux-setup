[[ $- == *i* ]] || return 0
[[ ${_LINUX_SETUP_BASH_READY:-} != 1 ]] || return 0
_LINUX_SETUP_BASH_READY=1
source "${XDG_CONFIG_HOME:-$HOME/.config}/linux-setup/config/bash/env"
mkdir -p "$XDG_STATE_HOME/bash"
HISTFILE="$XDG_STATE_HOME/bash/history"
HISTSIZE=50000
HISTFILESIZE=50000
shopt -s histappend checkwinsize
export BAT_CONFIG_PATH="$LINUX_SETUP_DIR/config/bat/config"
export RIPGREP_CONFIG_PATH="$LINUX_SETUP_DIR/config/ripgrep/config"
export LESS='-R'
export EDITOR="${EDITOR:-vi}"
export VISUAL="${VISUAL:-$EDITOR}"
source "$LINUX_SETUP_DIR/config/bash/aliases.sh"
source "$LINUX_SETUP_DIR/config/shell/developer-aliases.sh"
[[ ! -r "$LINUX_SETUP_DIR/config/completions/linux-setup.bash" ]] || source "$LINUX_SETUP_DIR/config/completions/linux-setup.bash"
# Restart Bash to reload your configuration.
alias reload='exec bash'
# Switch the current session between Bash and Zsh.
alias shell='exec shell-toggle --current bash'
command -v uv >/dev/null && eval "$(uv generate-shell-completion bash)"
command -v uvx >/dev/null && eval "$(uvx --generate-shell-completion bash)"
command -v zoxide >/dev/null && eval "$(zoxide init bash)"
if command -v fd >/dev/null; then
  export FZF_DEFAULT_COMMAND='fd --type f --hidden --exclude .git'
  export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
  export FZF_ALT_C_COMMAND='fd --type d --hidden --exclude .git'
fi
export FZF_DEFAULT_OPTS='--height=60% --layout=reverse --border'
source "$LINUX_SETUP_DIR/config/shell/file-preview.sh"
if command -v fzf >/dev/null && [[ -t 0 ]]; then
  eval "$(fzf --bash)"
fi
source "$LINUX_SETUP_DIR/config/bash/command-picker.sh"
# ble.sh is optional; Oh My Posh requires it for Bash transient prompts.
if [[ -r "$XDG_DATA_HOME/blesh/ble.sh" ]]; then
  source "$XDG_DATA_HOME/blesh/ble.sh" --noattach
fi
[[ ! -r "$XDG_CONFIG_HOME/linux-setup-local/theme.zsh" ]] || source "$XDG_CONFIG_HOME/linux-setup-local/theme.zsh"
if command -v oh-my-posh >/dev/null; then
  eval "$(oh-my-posh init bash --config "${LINUX_SETUP_POSH_THEME:-$LINUX_SETUP_DIR/config/oh-my-posh/quick-term.omp.json}")"
fi
[[ ! -r "$XDG_CONFIG_HOME/linux-setup-local/bashrc" ]] || source "$XDG_CONFIG_HOME/linux-setup-local/bashrc"
if declare -F ble-attach >/dev/null; then ble-attach; fi
return 0
