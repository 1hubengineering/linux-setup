{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "foreground": "lightYellow",
          "style": "plain",
          "template": "{{ .UserName }} ",
          "type": "session"
        },
        {
          "foreground": "cyan",
          "options": {
            "style": "agnoster_short",
            "max_depth": 2,
            "hide_root_location": true,
            "folder_icon": "",
            "folder_separator_icon": "/",
            "mapped_locations_enabled": false
          },
          "style": "plain",
          "template": "<#ffffff>in</> {{ if .RootDir }}{{ .Path }}{{ else }}{{ trimPrefix \"/\" .Path }}{{ end }} ",
          "type": "path"
        },
        {
          "foreground": "#ff94df",
          "options": {
            "branch_icon": " <#ff94df><b> </b></>"
          },
          "style": "plain",
          "template": "<#ffffff>on</> {{ .HEAD }}{{ if gt .StashCount 0 }}  {{ .StashCount }}{{ end }} ",
          "type": "git"
        }
      ],
      "type": "prompt",
      "newline": true
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "foreground": "lightGreen",
          "style": "plain",
          "template": "❯",
          "type": "text"
        }
      ],
      "type": "prompt"
    }
  ],
  "final_space": true,
  "version": 4,
  "transient_prompt": {
    "background": "transparent",
    "newline": false,
    "foreground": "lightGreen",
    "template": "❯ "
  },
  "secondary_prompt": {
    "background": "transparent",
    "foreground": "lightGreen",
    "template": "· "
  },
  "console_title_template": "{{ .Folder }}"
}
