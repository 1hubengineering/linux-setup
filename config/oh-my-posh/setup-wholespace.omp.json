{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "background": "#FEF5ED",
          "foreground": "#011627",
          "leading_diamond": "",
          "options": {
            "macos": " ",
            "ubuntu": " ",
            "windows": " "
          },
          "style": "diamond",
          "template": " {{ if .WSL }}WSL at {{ end }}{{.Icon}}",
          "trailing_diamond": "<transparent,#FEF5ED></>",
          "type": "os"
        },
        {
          "background": "#516BEB",
          "foreground": "#ffffff",
          "style": "diamond",
          "template": " {{ .UserName }} ",
          "type": "session",
          "leading_diamond": "",
          "trailing_diamond": ""
        },
        {
          "foreground": "#ffafd2",
          "options": {
            "style": "agnoster_short",
            "max_depth": 2,
            "hide_root_location": true,
            "folder_icon": "",
            "folder_separator_icon": "/",
            "mapped_locations_enabled": false
          },
          "style": "diamond",
          "template": " {{ if .RootDir }}{{ .Path }}{{ else }}{{ trimPrefix \"/\" .Path }}{{ end }} ",
          "type": "path"
        },
        {
          "background": "#17D7A0",
          "foreground": "#011627",
          "leading_diamond": "",
          "options": {
            "branch_icon": " "
          },
          "style": "diamond",
          "template": " {{ .UpstreamIcon }}{{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }}  {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }}  {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }}  {{ .StashCount }}{{ end }} ",
          "trailing_diamond": "",
          "type": "git"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "newline": false,
      "overflow": "hide",
      "segments": [
        {
          "background": "#FEF5ED",
          "foreground": "#011627",
          "leading_diamond": "",
          "options": {
            "time_format": "15:04:05"
          },
          "style": "diamond",
          "template": " ♥ {{ .CurrentDate | date .Format }} ",
          "trailing_diamond": "<transparent,#FEF5ED></>",
          "type": "time",
          "min_width": 100
        },
        {
          "background": "#516BEB",
          "foreground": "#ffffff",
          "leading_diamond": "",
          "style": "diamond",
          "template": " CPU: {{ round .PhysicalPercentUsed .Precision }}% | ",
          "type": "sysinfo",
          "min_width": 100
        },
        {
          "background": "#516BEB",
          "foreground": "#ffffff",
          "style": "diamond",
          "template": "RAM: {{ (div ((sub .PhysicalTotalMemory .PhysicalAvailableMemory)|float64) 1073741824.0) }}/{{ (div .PhysicalTotalMemory 1073741824.0) }}GB  ",
          "trailing_diamond": "<transparent,#516BEB></>",
          "type": "sysinfo",
          "min_width": 100
        },
        {
          "background": "#575656",
          "foreground": "#d6deeb",
          "leading_diamond": "",
          "options": {
            "style": "roundrock",
            "threshold": 0
          },
          "style": "diamond",
          "template": " {{ .FormattedMs }} ",
          "trailing_diamond": "",
          "type": "executiontime",
          "min_width": 100
        },
        {
          "background": "#ffffff",
          "foreground": "#000000",
          "leading_diamond": "",
          "options": {
            "fetch_package_manager": true,
            "npm_icon": " <#cc3a3a></> ",
            "yarn_icon": " <#348cba></>"
          },
          "style": "diamond",
          "template": " {{ if .PackageManagerIcon }}{{ .PackageManagerIcon }} {{ end }}{{ .Full }}",
          "trailing_diamond": "<transparent,#ffffff></>",
          "type": "node",
          "min_width": 100
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "foreground": "#00ff15",
          "foreground_templates": [
            "{{ if gt .Code 0 }}#ff0000{{ end }}"
          ],
          "options": {
            "always_enabled": true
          },
          "style": "plain",
          "template": "",
          "type": "status"
        }
      ]
    }
  ],
  "console_title_template": "{{ .Folder }}",
  "transient_prompt": {
    "background": "transparent",
    "newline": false,
    "foreground": "#00ff15",
    "template": " "
  },
  "version": 4,
  "final_space": true,
  "secondary_prompt": {
    "background": "transparent",
    "foreground": "#00ff15",
    "template": "· "
  }
}
